{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾光",
  "version": "0.1.0",
  "identifier": "com.shiguang.dydownload",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "center": true,
        "title": "拾光 · 抖音作品下载器",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#edf2f9"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: asset: http://asset.localhost; media-src https: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "simonius",
    "copyright": "Copyright © 2026 simonius",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
